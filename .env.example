# Provide an existing Comfy workspace key locally; never commit real credentials.
COMFY_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org
# Only for a self-hosted proxy that requires its own bearer token.
COMFY_LOCAL_TOKEN=
# Self-hosted app only: ComfyUI itself, through a loopback SSH forward if remote.
COMFY_UPSTREAM_URL=
# Optional MOSS opening-look worker: a separate loopback official proxy and ComfyUI.
COMFY_LOOK_BASE_URL=
COMFY_LOOK_UPSTREAM_URL=
# Never reuse a Cloud or video-worker credential for this proxy.
COMFY_LOOK_LOCAL_TOKEN=
