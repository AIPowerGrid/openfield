# Provide an existing Comfy workspace key locally; never commit real credentials.
COMFY_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org
# Only for a self-hosted proxy that requires its own bearer token.
COMFY_LOCAL_TOKEN=
# Self-hosted app only: ComfyUI itself, through a loopback SSH forward if remote.
COMFY_UPSTREAM_URL=
# Optional MOSS opening-look worker: a separate loopback official proxy and ComfyUI.
COMFY_LOOK_BASE_URL=
COMFY_LOOK_UPSTREAM_URL=
# Never reuse a Cloud or video-worker credential for this proxy.
COMFY_LOOK_LOCAL_TOKEN=
# Optional tool worker (FPS boost, background removal, upscale): a separate
# official proxy and its ComfyUI; both default to the video worker above.
COMFY_TOOL_BASE_URL=
COMFY_TOOL_UPSTREAM_URL=
# AI Power Grid key for briefs and music (https://aipowergrid.io); never commit it.
GRID_API_KEY=
# Grid API base; leave empty for the public endpoint.
GRID_BASE_URL=
# Optional OpenAI-compatible LLM for brief writing instead of the Grid default.
OPENFIELD_LLM_URL=
OPENFIELD_LLM_MODEL=
# Where openfield-mcp finds the running studio (default http://127.0.0.1:8793).
OPENFIELD_URL=
